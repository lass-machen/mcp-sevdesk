{
  "name": "mcp-sevdesk",
  "version": "1.0.0",
  "description": "MCP Server for sevdesk API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-sevdesk": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-types": "openapi-typescript openapi/sevdesk-openapi.yaml -o src/generated/sevdesk-api.ts",
    "prepare": "npm run generate-types && npm run build"
  },
  "keywords": [
    "mcp",
    "sevdesk",
    "api",
    "accounting",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "openapi-fetch": "^0.17.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.7",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.4"
  }
}
