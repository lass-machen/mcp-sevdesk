# Values are interpolated by Docker Compose: a "$" starts a variable reference
# and must be written as "$$". The generated hex tokens below never need that.

# sevdesk API token (sevdesk: Einstellungen -> Benutzer -> API-Token)
SEVDESK_API_TOKEN=

# Bearer token clients must send as "Authorization: Bearer <token>".
# At least 32 characters from A-Z a-z 0-9 - . _ ~ + / (optionally followed by =).
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Optional: comma-separated hostnames (without scheme or port) accepted in the
# Host header, e.g. the public domain of the deployment. Empty disables the
# check, except when the server binds to a loopback address.
MCP_ALLOWED_HOSTS=

# Optional: comma-separated origins (e.g. https://claude.ai) accepted in the
# Origin header. Requests without an Origin header are always accepted.
# Empty disables the check.
MCP_ALLOWED_ORIGINS=

# Optional: maximum request size between 1kb and 100mb (default 10mb).
# Relevant for upload_voucher_file, which receives the file base64-encoded.
MCP_HTTP_BODY_LIMIT=

# Optional: true registers only read-only tools, so no data in sevdesk can be
# changed through this server. Default: false
MCP_READ_ONLY=
